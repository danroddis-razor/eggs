@{
    ViewData["Title"] = "Eggs";
    Layout = "_Layout";
}

@section Styles {
    <style>
        html, body {
            margin: 0;
            height: 100%;
        }

        body {
            display: flex;
            align-items: center;
            justify-content: center;
            font-family: Arial, Helvetica, sans-serif;
        }

        .egg-page {
            display: flex;
            flex-direction: column;
            align-items: center;
            gap: 0.5rem;
        }

        .egg-emoji {
            font-size: 4rem;
            line-height: 1;
        }

        .eggs-label {
            font-family: Arial, Helvetica, sans-serif;
        }
    </style>
}

<main class="egg-page">
    <span class="egg-emoji">🥚</span>
    <p class="eggs-label">Eggs</p>
</main>
